# Copy to .env.local and fill in from your Shopify admin.
# These are PUBLIC values by design — the storefront token is scoped to
# unauthenticated reads and cart mutations. Never add an Admin API token here.

NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-01

# Meta pixel ID from Events Manager, for Instagram and Facebook ads. Leave it
# empty and the pixel stays off. Public by design, like the values above.
NEXT_PUBLIC_META_PIXEL_ID=
